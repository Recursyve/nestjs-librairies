{
    "name": "@recursyve/nestjs-sequelize-utils",
    "version": "11.0.0",
    "description": "Sequelize utilities for NestJs",
    "main": "index.js",
    "scripts": {
        "build": "rimraf dist && nest build",
        "build:lib": "rimraf dist && nest build -p tsconfig.lib.json",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build:lib && cd dist && npm pack",
        "lint": "eslint \"{lib,tests,examples}/**/*.ts\"",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "publish-package": "npm run build:lib && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/sequelize-utils"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=11.0.0",
        "@nestjs/core": ">=11.0.0",
        "@nestjs/sequelize": ">=11.0.0",
        "sequelize": ">=6.37.0",
        "sequelize-typescript": ">=2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/common": "^11.0.12",
        "@nestjs/core": "^11.0.12",
        "@nestjs/sequelize": "^11.0.0",
        "@nestjs/testing": "^11.0.12",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.7",
        "sequelize-typescript": "^2.1.6",
        "sqlite3": "^5.1.7",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
