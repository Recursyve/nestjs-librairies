{
    "name": "@recursyve/nestjs-config-sequelize",
    "version": "12.0.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "pack:lib": "npm run build && cd dist && npm pack",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "publish-package": "npm run build && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/sequelize": ">=12.0.0",
        "@recursyve/nestjs-config": ">=12.0.0",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@softarc/eslint-plugin-sheriff": "^0.20.0",
        "@softarc/sheriff-core": "^0.20.0",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/sequelize": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@recursyve/nestjs-config": "file:../config",
        "@types/node": "^22.13.13",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "class-transformer": "^0.5.1",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6",
        "sqlite3": "^5.1.7",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
