{
    "compileOnSave": false,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2021",
        "moduleResolution": "bundler",
        "rootDir": "src",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "lib": ["es2021"],
        "types": ["node", "jest"],
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "build"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
