{
    "name": "@recursyve/nestjs-redis",
    "version": "12.0.0",
    "description": "Recursyve's NestJs Redis client",
    "main": "index.js",
    "scripts": {
        "build": "rimraf dist && nest build",
        "build:lib": "rimraf dist && nest build -p tsconfig.lib.json",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build:lib && cd dist && npm pack",
        "lint": "eslint \"{lib,tests}/**/*.ts\"",
        "test": "vitest run",
        "publish-package": "npm run build:lib && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/redis"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/terminus": ">=12.0.0"
    },
    "dependencies": {
        "ioredis": "^5.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.11",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/terminus": "^12.1.0",
        "@nestjs/testing": "^12.3.2",
        "@types/node": "^22.13.14",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
