{
    "compileOnSave": false,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2021",
        "moduleResolution": "node",
        "declaration": true,
        "skipLibCheck": true,
        "strict": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/test/**/*",
        "src/**/*.spec.ts"
    ]
}
