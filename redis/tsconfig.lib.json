{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2018",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist"
  },
  "include": [
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
