{
    "name": "@recursyve/nestjs-config-sequelize",
    "version": "12.0.0",
    "main": "index.js",
    "scripts": {
        "build": "rimraf dist && nest build",
        "build:lib": "rimraf dist && nest build -p tsconfig.lib.json",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build:lib && npm run copy:lib && cd dist && npm pack",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"{src,tests}/**/*.ts\"",
        "test": "vitest run",
        "publish-package": "npm run build:lib && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/sequelize": ">=12.0.0",
        "@recursyve/nestjs-config": ">=12.0.0",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.11",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/sequelize": "^12.0.0",
        "@nestjs/testing": "^12.3.2",
        "@recursyve/nestjs-config": "^12.0.0",
        "@types/node": "^22.13.13",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "class-transformer": "^0.5.1",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6",
        "sqlite3": "^5.1.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
