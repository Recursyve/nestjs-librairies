{
    "compileOnSave": false,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2021",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "declaration": true,
        "strict": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "outDir": "dist"
    },
    "include": [
        "src/**/*",
        "index.ts"
    ],
    "exclude": [
        "node_modules",
        "src/test/**/*",
        "src/**/*.spec.ts"
    ]
}
