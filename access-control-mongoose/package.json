{
    "name": "@recursyve/nestjs-access-control-mongoose",
    "version": "12.0.0",
    "description": "Mongoose utilities for Recursyve's NestJs AccessControl library",
    "main": "index.js",
    "scripts": {
        "build": "rimraf dist && nest build",
        "build:lib": "rimraf dist && nest build -p tsconfig.lib.json",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build:lib && npm run copy:lib && cd dist && npm pack",
        "test": "jest",
        "publish-package": "npm run build:lib && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/access-control-mongoose"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/mongoose": ">=12.0.0",
        "@recursyve/nestjs-access-control": ">=12.0.0",
        "mongoose": ">=9.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.11",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/cqrs": "^12.1.2",
        "@nestjs/mongoose": "^12.0.0",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/terminus": "^12.1.0",
        "@nestjs/testing": "^12.3.2",
        "@recursyve/eslint-config-node": "^1.0.1",
        "@recursyve/nestjs-access-control": "^12.0.0",
        "@recursyve/nestjs-redis": "^12.0.0",
        "@types/jest": "^29.5.14",
        "@typescript-eslint/eslint-plugin": "^5.48.0",
        "@typescript-eslint/parser": "^5.48.0",
        "eslint": "^8.31.0",
        "eslint-config-prettier": "^8.6.0",
        "eslint-plugin-prettier": "^4.2.1",
        "jest": "^29.7.0",
        "mongoose": "^9.8.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "tests",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "./coverage",
        "testEnvironment": "node"
    }
}
