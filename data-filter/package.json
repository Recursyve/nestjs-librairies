{
    "name": "@recursyve/nestjs-data-filter",
    "version": "12.0.0",
    "description": "NestJs DataFilter library",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build && cd dist && npm pack",
        "publish-package": "npm run build && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"lib/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest --coverage",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/data-filter"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@recursyve/nestjs-common": ">=12.0.0",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "sequelize": ">=6.37.0",
        "sequelize-typescript": ">=2.1.0"
    },
    "dependencies": {
        "@nestjs/swagger": "^12.0.2",
        "csv-stringify": "^6.5.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@softarc/eslint-plugin-sheriff": "^0.20.0",
        "@softarc/sheriff-core": "^0.20.0",
        "@recursyve/nestjs-common": "file:../common",
        "@types/express": "^5.0.1",
        "@types/node": "^22.13.13",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "eslint": "^10.10.0",
        "express": "^5.0.1",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6",
        "sqlite3": "^6.0.1",
        "ts-node": "^10.9.2",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
