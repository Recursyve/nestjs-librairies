{
    "compileOnSave": false,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2018",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "declaration": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "strict": true,
        "types": [
            "node",
            "express",
            "multer"
        ],
        "outDir": "dist"
    },
    "include": [
        "lib/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
