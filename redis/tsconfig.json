{
    "compileOnSave": false,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2018",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "lib": [
            "es2018"
        ],
        "strict": true,
        "sourceMap": true,
        "outDir": "build",
        "rootDir": "lib",
        "skipLibCheck": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "lib/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
