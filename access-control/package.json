{
    "name": "@recursyve/nestjs-access-control",
    "version": "12.0.0",
    "description": "NestJs AccessControl library",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"{lib,tests}/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "publish-package": "npm run build && npm publish --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/access-control"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/cqrs": ">=12.0.0",
        "@recursyve/nestjs-redis": ">=12.0.0"
    },
    "dependencies": {
        "@recursyve/nice-ts-utils": "^0.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.11",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/cqrs": "^12.1.2",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/testing": "^12.3.2",
        "@recursyve/nestjs-redis": "^12.0.0",
        "@softarc/eslint-plugin-sheriff": "^0.20.0",
        "@softarc/sheriff-core": "^0.20.0",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ts-node": "^10.9.2",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
