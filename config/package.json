{
    "name": "@recursyve/nestjs-config",
    "version": "12.0.0",
    "scripts": {
        "build": "rimraf dist && nest build",
        "build:lib": "rimraf dist && nest build -p tsconfig.lib.json",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build:lib && npm run copy:lib && cd dist && npm pack",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "publish-package": "npm run build:lib && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "class-transformer": "^0.5.1",
        "reflect-metadata": "^0.1.12 || ^0.2.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.11",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/testing": "^12.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.8.0",
        "jest": "^30.5.2",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.6.0",
        "ts-jest": "^29.4.15",
        "typescript": "^6.0.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "coverageDirectory": "./coverage",
        "testEnvironment": "node"
    }
}
