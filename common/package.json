{
    "name": "@recursyve/nestjs-common",
    "version": "11.0.0",
    "description": "Recursyve's NestJs common library",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build && cd dist && npm pack",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"{lib,tests}/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "publish-package": "npm run build && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/common"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=11.0.0",
        "@nestjs/core": ">=11.0.0",
        "@nestjs/platform-express": ">=11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.13.0 || ^0.14.0",
        "date-fns": "^4.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/common": "^11.0.12",
        "@nestjs/core": "^11.0.12",
        "@softarc/eslint-plugin-sheriff": "^0.20.0",
        "@softarc/sheriff-core": "^0.20.0",
        "@types/express": "^5.0.1",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.13",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "date-fns": "^4.1.0",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@recursyve/nice-ts-utils": "^0.0.3"
    }
}
