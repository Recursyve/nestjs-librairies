{
    "name": "test-app",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "npm --prefix .. run build:lib && nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "npm --prefix .. run build:lib && nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/sequelize": "^11.0.1",
        "@recursyve/nestjs-common": "^11.0.0",
        "@recursyve/nestjs-data-filter": "file:..",
        "@recursyve/nice-ts-utils": "^0.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "mysql2": "^3.23.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sequelize": "^6.37.6",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/core": "^1.15.46",
        "@testcontainers/mysql": "^12.0.4",
        "@types/express": "^5.0.0",
        "@types/node": "^24.13.3",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.18.0",
        "globals": "^17.0.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "unplugin-swc": "^1.5.9",
        "vitest": "^4.1.10"
    }
}
