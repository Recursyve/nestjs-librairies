{
    "name": "@recursyve/nestjs-redis",
    "version": "12.0.0",
    "description": "Recursyve's NestJs Redis client",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "copy:lib": "cp package.json .npmignore dist",
        "pack:lib": "npm run build && cd dist && npm pack",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "eslint \"lib/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "publish-package": "npm run build && npm run copy:lib && npm publish ./dist --access public",
        "publish-package:beta": "npm run publish-package -- --tag beta --access public",
        "publish-package:dry-run": "npm run publish-package -- --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/nestjs-librairies/redis"
    },
    "author": "Recursyve",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/terminus": ">=12.0.0"
    },
    "dependencies": {
        "ioredis": "^5.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@softarc/eslint-plugin-sheriff": "^0.20.0",
        "@softarc/sheriff-core": "^0.20.0",
        "@types/node": "^22.13.14",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "oxfmt": "^0.67.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
